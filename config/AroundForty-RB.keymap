#define MAC_BASE_LAYER 0
#define WIN_BASE_LAYER 1
#define WIN_FNC_LAYER 2
#define MAC_FNC_LAYER 3
#define WIN_COMMON_LAYER 4
#define MAC_COMMON_LAYER 5
#define NUM_SCROLL_LAYER 6
#define V_SCROLL_LAYER 7
#define SETTINGS_LAYER 8
#define AML_LAYER 9
#define NAGINATA_LAYER 10

#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <behaviors/naginata.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        combo_ng_on {
            timeout-ms = <300>;
            bindings = <&ng_on>;
            key-positions = <15 16>;
            layers = <MAC_BASE_LAYER>;
        };

        combo_ng_off {
            timeout-ms = <300>;
            bindings = <&ng_off>;
            key-positions = <13 14>;
            layers = <MAC_BASE_LAYER NAGINATA_LAYER>;
        };

        combo_return {
            timeout-ms = <50>;
            bindings = <&kp ENTER>;
            key-positions = <23 27>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to MAC_BASE_LAYER &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // Windows用入力切り替え：Alt + Grave (~)

        ime_tog: ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LALT>;
        };

        // macOS用入力切り替え：Ctrl + Space

        mac_ime: mac_ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCTRL>;
        };

        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANGUAGE_1 &kp INTERNATIONAL_4 &to NAGINATA_LAYER>;
        };

        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANGUAGE_2 &kp INTERNATIONAL_5 &to MAC_BASE_LAYER>;
        };

        base_with_mod: base_with_mod {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_press &tog NAGINATA_LAYER>
                , <&macro_param_1to1>
                , <&macro_press &kp MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &kp MACRO_PLACEHOLDER>
                , <&macro_press &tog NAGINATA_LAYER>
                ;
        };

        // NAGINATA_LAYER is above the utility layers, so momentary layer keys
        // need to disable it while held.

        base_mo: base_mo {
            compatible = "zmk,behavior-macro-one-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <1>;
            bindings
                = <&macro_press &tog NAGINATA_LAYER>
                , <&macro_param_1to1>
                , <&macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_release &mo MACRO_PLACEHOLDER>
                , <&macro_press &tog NAGINATA_LAYER>
                ;
        };

        base_lt: base_lt {
            compatible = "zmk,behavior-macro-two-param";
            wait-ms = <0>;
            tap-ms = <0>;
            #binding-cells = <2>;
            bindings
                = <&macro_press &tog NAGINATA_LAYER>
                , <&macro_param_1to1>
                , <&macro_param_2to2>
                , <&macro_press &lt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1>
                , <&macro_param_2to2>
                , <&macro_release &lt MACRO_PLACEHOLDER MACRO_PLACEHOLDER>
                , <&macro_press &tog NAGINATA_LAYER>
                ;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Mac-Base {
            display-name = "Mac-Base";
            bindings = <
&kp Q       &kp W         &kp E         &kp R                 &kp T                             &kp Y        &kp U        &kp I          &kp O           &kp P
&kp A       &kp S         &kp D         &kp F                 &kp G                             &kp H        &kp J        &kp K          &kp L           &lt AML_LAYER SEMICOLON
&kp Z       &kp X         &kp C         &kp V                 &kp B        &mac_ime             &kp N        &kp M        &kp COMMA      &kp DOT         &mt RIGHT_SHIFT SLASH
&kp LCTRL   &kp LEFT_ALT  &kp LEFT_GUI  &lt NUM_SCROLL_LAYER LANGUAGE_2  &mt LEFT_SHIFT SPACE  &lt MAC_FNC_LAYER LANGUAGE_1  &mt LEFT_SHIFT SPACE  &kp AT_SIGN  &kp BACKSPACE  &mo SETTINGS_LAYER  &lt MAC_COMMON_LAYER DEL
            >;
        };

        Win-Base {
            display-name = "Win-Base";
            bindings = <
&kp Q             &kp W     &kp E     &kp R                 &kp T                          &kp Y        &kp U        &kp I          &kp O            &kp P
&kp A             &kp S     &kp D     &kp F                 &kp G                          &kp H        &kp J        &kp K          &kp L            &lt V_SCROLL_LAYER MINUS
&mt LEFT_SHIFT Z  &kp X     &kp C     &kp V                 &kp B        &ime_tog          &kp N        &kp M        &kp COMMA      &kp DOT          &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LGUI  &kp LALT  &mt LSHFT LANGUAGE_1  &lt WIN_FNC_LAYER SPACE  &lt NUM_SCROLL_LAYER LANGUAGE_2  &lt WIN_COMMON_LAYER ENTER  &kp AT_SIGN  &kp BACKSPACE  &lt SETTINGS_LAYER RIGHT_GUI  &kp DEL
            >;
        };

        Win-Fnc {
            display-name = "Win-Fnc";
            bindings = <
&kp LC(A)       &kp LC(X)     &kp LC(C)    &kp LC(V)  &kp LC(F)          &kp LESS_THAN         &kp GREATER_THAN       &kp CARET        &kp PERCENT    &kp DOLLAR
&kp TAB         &kp LEFT_ALT  &kp LS(TAB)  &mkp MB1   &mkp MB2           &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AT_SIGN      &kp AMPERSAND  &kp DOUBLE_QUOTES
&kp LEFT_SHIFT  &trans        &trans       &trans     &mkp MB3   &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EXCLAMATION  &kp QUESTION   &kp SINGLE_QUOTE
&kp LCTRL       &trans        &trans       &trans     &trans     &trans  &trans                &trans                 &kp BACKSPACE    &kp ENTER      &kp HASH
            >;
        };

        Mac-Fnc {
            display-name = "Mac-Fnc";
            bindings = <
&kp LG(A)       &kp LG(X)     &kp LG(C)    &kp LG(V)  &kp LG(F)             &kp LESS_THAN         &kp GREATER_THAN       &kp CARET        &kp PERCENT    &kp DOLLAR
&kp TAB         &kp LEFT_GUI  &kp LS(TAB)  &mkp MB1   &mkp MB2              &kp LEFT_PARENTHESIS  &mkp MB1                &mkp MB2         &kp AMPERSAND  &kp DOUBLE_QUOTES
&kp LEFT_SHIFT  &trans        &trans       &trans     &mkp MB3   &kp LG(R)  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp EXCLAMATION  &kp QUESTION   &kp SINGLE_QUOTE
&kp LCTRL       &trans        &trans       &trans     &trans     &trans     &trans                &trans                 &kp BACKSPACE    &kp ENTER      &kp HASH
            >;
        };

        Win-Common {
            display-name = "Win-Common";
            bindings = <
&kp ESC    &kp LG(DOWN_ARROW)  &kp LG(UP_ARROW)     &kp LG(LC(UP_ARROW))    &kp LA(UP_ARROW)                        &kp LC(W)          &kp LA(LEFT_ARROW)  &mkp MB3        &kp LA(RIGHT_ARROW)  &kp HOME
&kp TAB    &kp LEFT_ALT        &kp LS(TAB)          &kp LG(LC(LEFT_ARROW))  &kp LG(LC(RIGHT_ARROW))                 &kp LC(PAGE_UP)    &mkp MB1            &kp UP_ARROW    &mkp MB2             &kp PAGE_UP
&kp LSHFT  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)  &kp LG(LC(F4))          &kp LA(DOWN_ARROW)       &kp LG(LS(S))  &kp LC(PAGE_DOWN)  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp PAGE_DOWN
&kp LCTRL  &trans              &trans               &trans                  &trans                   &trans         &trans             &kp LC(T)           &trans          &trans               &kp END
            >;
        };

        Mac-Common {
            display-name = "Mac-Common";
            bindings = <
&kp ESC    &trans        &trans       &kp LC(UP_ARROW)    &kp LG(UP_ARROW)                           &kp LG(W)        &kp LG(LEFT_ARROW)  &mkp MB3        &kp LG(RIGHT_ARROW)  &kp HOME
&kp TAB    &kp LEFT_GUI  &kp LS(TAB)  &kp LC(LEFT_ARROW)  &kp LC(RIGHT_ARROW)                        &kp LC(TAB)      &mkp MB1            &kp UP_ARROW    &mkp MB2             &kp PAGE_UP
&kp LSHFT  &trans        &trans       &kp LC(DOWN_ARROW)  &kp LG(DOWN_ARROW)   &kp LG(LS(NUMBER_4))  &kp LS(LC(TAB))  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp PAGE_DOWN
&kp LCTRL  &trans        &trans       &trans              &trans               &trans                &trans           &kp LG(T)           &trans          &trans               &kp END
            >;
        };

        Num_Scroll {
            bindings = <
&kp N1     &kp N2        &kp N3        &kp N4        &kp N5                         &kp N6          &kp N7          &kp N8        &kp N9           &kp N0
&kp TAB    &kp LS(MINUS) &kp PLUS      &kp COLON     &kp MINUS                      &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp ENTER
&trans     &kp LEFT_ALT  &kp LEFT_GUI  &trans        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans          &trans        &trans           &trans          &trans
&trans     &trans        &trans        &trans        &trans            &trans             &trans          &trans        &trans           &trans          &trans
            >;
        };

        V_Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Settings {
            display-name = "Settings";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4         &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans         &trans        &trans          &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &to MAC_BASE_LAYER  &trans        &trans          &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &to WIN_BASE_LAYER  &sys_reset    &studio_unlock  &bootloader   &trans        &bt BT_CLR_ALL
            >;
        };

        AML {
            display-name = "AML";
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };

        NAGINATA {
            display-name = "NAGINATA";
            bindings = <
&ng Q                  &ng W                   &ng E                   &ng R                   &ng T                             &ng Y        &ng U         &ng I        &ng O       &ng P
&ng A                  &ng S                   &ng D                   &ng F                   &ng G                             &ng H        &ng J         &ng K        &ng L       &ng SEMI
&ng Z                  &ng X                   &ng C                   &ng V                   &ng B        &ng SPACE             &ng N        &ng M         &ng COMMA    &ng DOT     &ng SLASH
&base_with_mod LCTRL   &base_with_mod LEFT_ALT  &base_with_mod LEFT_GUI  &base_mo NUM_SCROLL_LAYER  &ng SPACE    &base_lt MAC_FNC_LAYER LANGUAGE_1  &ng SPACE    &kp AT_SIGN   &kp BACKSPACE  &base_mo SETTINGS_LAYER  &base_lt MAC_COMMON_LAYER DEL
            >;
        };
    };
};
